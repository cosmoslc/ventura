# Nusxa oling: .env — haqiqiy qiymatlar faqat o'sha faylda (repoga tushmaydi).

# Panel ishlaydigan foydalanuvchi (audit jadvalida UPDATE/DELETE huquqi yo'q)
PANEL_DATABASE_URL=postgres://ventura_app:PAROL@localhost:5432/ventura_panel
# Migratsiyalar uchun baza egasi
PANEL_MIGRATE_URL=postgres://ventura:PAROL@localhost:5432/ventura_panel

# Better Auth: kamida 32 belgili tasodifiy satr
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# AES-256-GCM asosiy kaliti joylashgan fayl (32 bayt, base64)
VENTURA_MASTER_KEY_FILE=.secrets/master.key

# Telegram bot tokeni (@BotFather)
TELEGRAM_BOT_TOKEN=
