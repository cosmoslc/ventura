{
  "name": "ventura",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @ventura/db db:migrate",
    "db:generate": "pnpm --filter @ventura/db db:generate",
    "admin:create": "pnpm --filter @ventura/scripts admin:create",
    "admin:reset-2fa": "pnpm --filter @ventura/scripts admin:reset-2fa",
    "admin:unlock": "pnpm --filter @ventura/scripts admin:unlock",
    "templates:sync": "pnpm --filter @ventura/scripts templates:sync",
    "e2e": "pnpm --filter @ventura/panel e2e",
    "worker": "pnpm --filter @ventura/worker start"
  },
  "devDependencies": {
    "turbo": "^2.11.7",
    "typescript": "^5.9.3",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=22"
  }
}
