{
  "name": "@ventura/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema/panel": "./src/schema/panel/index.ts",
    "./schema/tenant": "./src/schema/tenant/index.ts",
    "./schema/sawmill": "./src/schema/sawmill/index.ts",
    "./migrate": "./src/tenant-migrate.ts",
    "./migrate/sawmill": "./src/sawmill-migrate.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env node_modules/drizzle-kit/bin.cjs migrate",
    "db:generate:tenant": "drizzle-kit generate --config drizzle.tenant.config.ts",
    "db:migrate:tenant": "node --env-file-if-exists=../../.env node_modules/drizzle-kit/bin.cjs migrate --config drizzle.tenant.config.ts",
    "db:generate:sawmill": "drizzle-kit generate --config drizzle.sawmill.config.ts",
    "db:migrate:sawmill": "node --env-file-if-exists=../../.env node_modules/drizzle-kit/bin.cjs migrate --config drizzle.sawmill.config.ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@ventura/config": "workspace:*",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
