# ============================================================
# Ventura PC-CRM — Muhit o'zgaruvchilari namunasi
# Nusxalash: cp .env.example .env
# So'ng qiymatlarni o'zgartiring.
# ============================================================

# ------------------------------------------------------------
# 🗄️  Ma'lumotlar bazasi (PostgreSQL — Dedicated Silo)
# ------------------------------------------------------------

# App runtime ulanishi (ikkinchi qator yoki bu yetarli)
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/pc_crm_dev

# Yoki alohida nom (DATABASE_URL bo'lmasa ishlatiladi)
PC_CRM_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/pc_crm_dev

# Migration uchun (yuqori huquqli foydalanuvchi bo'lsa alohida)
PC_CRM_MIGRATE_URL=postgres://USER:PASSWORD@localhost:5432/pc_crm_dev

# ------------------------------------------------------------
# 🔐  Autentifikatsiya (Better Auth)
# ------------------------------------------------------------

# Maxfiy kalit — kamida 32 belgili tasodifiy qator
# Generatsiya: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Ilovangiz asosiy URL manzili
BETTER_AUTH_URL=http://localhost:3004

# Ruxsat etilgan manbalar (vergul bilan ajrating)
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3004

# ------------------------------------------------------------
# 🌐  Ilova URL (NEXT_PUBLIC_* — brauzerda ham ko'rinadi)
# ------------------------------------------------------------

NEXT_PUBLIC_APP_URL=http://localhost:3004

# ------------------------------------------------------------
# 🔑  Google OAuth (ixtiyoriy)
# Ulash: https://console.cloud.google.com/ → Credentials
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
# ------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
