# Nusxa oling: .env — haqiqiy qiymatlar faqat o'sha faylda (repoga tushmaydi).

# Panel ishlaydigan foydalanuvchi (audit jadvalida UPDATE/DELETE huquqi yo'q)
PANEL_DATABASE_URL=postgres://ventura_app:PAROL@localhost:5432/ventura_panel
# Migratsiyalar uchun baza egasi
PANEL_MIGRATE_URL=postgres://ventura:PAROL@localhost:5432/ventura_panel

# Better Auth: kamida 32 belgili tasodifiy satr
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Panel bir nechta manzildan ochilsa (tunnel: BETTER_AUTH_URL=https://admin.ventura.uz), qolganlari vergul bilan
BETTER_AUTH_TRUSTED_ORIGINS=

# AES-256-GCM asosiy kaliti joylashgan fayl (32 bayt, base64)
VENTURA_MASTER_KEY_FILE=.secrets/master.key

# Telegram bot tokeni (@BotFather)
TELEGRAM_BOT_TOKEN=
# Ixtiyoriy: o'z Bot API serveri manzili (standart: https://api.telegram.org)
# TELEGRAM_API_URL=

# Deploy drayveri: `ssh` — ro'yxatdagi serverga haqiqiy deploy (avval `pnpm server:add` va serverda setup.sh);
# `sim` — sinov: hech qaysi serverga ulanmaydi, faqat jarayonni ko'rsatadi (berilmasa shu)
DEPLOY_DRIVER=sim
# Ventura SMS paketi (ADR 0056): markazlar SMS'ni shu manzildagi panel orqali yuboradi. Deploy uni va loyiha kalitini
# markazning maxfiy sozlamasiga yozadi. Berilmasa BETTER_AUTH_URL olinadi; ikkalasi ham bo'lmasa paket ishlamaydi.
# VENTURA_PANEL_URL=https://admin.ventura.uz

# ---------- edu-crm (shablon) ----------
# Mijozlar ro'yxati (domen → mijoz, brend, bo'limlar; sirlarsiz). Serverda panel deploy paytida yozadi.
VENTURA_TENANTS_FILE=.secrets/tenants.json
# Mijozlarning maxfiy sozlamalari: baza manzili, sessiya kaliti, Telegram bot tokeni (0600, faqat server).
VENTURA_TENANT_SECRETS_FILE=.secrets/tenant-secrets.json
# Mijoz bazasi migratsiyasi qo'lda (pnpm db:migrate:tenant): baza egasi
# TENANT_MIGRATE_URL=postgres://ventura:PAROL@localhost:5432/edu_shared
# Ajratish testlari (pnpm test): baza va rol yarata oladigan foydalanuvchi; berilmasa testlar o'tkazib yuboriladi
# TENANT_TEST_ADMIN_URL=postgres://postgres:PAROL@localhost:5432/postgres

# edu-crm: ishga tushganda Telegram webhook'larini sir bilan qayta o'rnatish (faqat production). off — o'chirish
# TELEGRAM_WEBHOOK_SYNC=off
# Sawmill DB testlari (pnpm test): sawmill sxemasi migratsiya qilingan baza; berilmasa o'tkazib yuboriladi
# SAWMILL_TEST_DATABASE_URL=postgres://ventura:PAROL@localhost:5432/edu_dev?options=-csearch_path%3Dsawmill
