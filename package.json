{
  "name": "ventura",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @ventura/db db:migrate",
    "db:generate": "pnpm --filter @ventura/db db:generate",
    "admin:create": "pnpm --filter @ventura/scripts admin:create",
    "admin:reset-2fa": "pnpm --filter @ventura/scripts admin:reset-2fa",
    "admin:unlock": "pnpm --filter @ventura/scripts admin:unlock",
    "templates:sync": "pnpm --filter @ventura/scripts templates:sync",
    "e2e": "pnpm --filter @ventura/panel e2e",
    "e2e:edu": "pnpm --filter @ventura/edu-crm e2e",
    "e2e:sawmill": "pnpm --filter @ventura/sawmill e2e",
    "e2e:pc": "pnpm --filter @ventura/pc-crm e2e",
    "worker": "pnpm --filter @ventura/worker start",
    "server:add": "pnpm --filter @ventura/scripts server:add",
    "server:check": "pnpm --filter @ventura/scripts server:check",
    "deploy:run": "pnpm --filter @ventura/scripts deploy:run",
    "db:generate:tenant": "pnpm --filter @ventura/db db:generate:tenant",
    "db:migrate:tenant": "pnpm --filter @ventura/db db:migrate:tenant",
    "db:generate:sawmill": "pnpm --filter @ventura/db db:generate:sawmill",
    "db:migrate:sawmill": "pnpm --filter @ventura/db db:migrate:sawmill",
    "db:generate:pc-crm": "pnpm --filter @ventura/db db:generate:pc-crm",
    "db:migrate:pc-crm": "pnpm --filter @ventura/db db:migrate:pc-crm",
    "edu:tenant": "pnpm --filter @ventura/scripts edu:tenant",
    "edu:staff": "pnpm --filter @ventura/scripts edu:staff",
    "edu:seed": "pnpm --filter @ventura/scripts edu:seed",
    "edu:seed-reports": "pnpm --filter @ventura/scripts edu:seed-reports",
    "pc:tenant": "pnpm --filter @ventura/scripts pc:tenant",
    "pc:seed": "pnpm --filter @ventura/scripts pc:seed"
  },
  "devDependencies": {
    "turbo": "^2.11.7",
    "typescript": "^5.9.3",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=22"
  }
}
